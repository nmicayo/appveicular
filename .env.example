# PostgreSQL connection string
# Default uses port 5433 to avoid conflicts with local PostgreSQL installations
# Format: postgres://user:password@host:port/database?sslmode=disable
DATABASE_URL="postgres://postgres:mysecretpassword@localhost:5433/local?sslmode=disable"

# Better Auth secret key (will be auto-generated during setup)
# You can also generate manually with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here"
